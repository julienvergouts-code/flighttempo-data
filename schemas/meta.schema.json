{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlightTempo dataset metadata",
  "type": "object",
  "required": [
    "source",
    "airacCycle",
    "effectiveDate",
    "expiryDate",
    "sha256",
    "licenceStatus"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "airacCycle": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "expiryDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "licenceStatus": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "licenseName": {
      "type": [
        "string",
        "null"
      ]
    },
    "attribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage": {
      "type": [
        "string",
        "null"
      ]
    },
    "recordCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": true
}
